{
  "name": "tran-pack-backend",
  "version": "1.0.0",
  "description": "API Tran-Pack - Gestión de ventas",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:setup": "node src/database/setup.js",
    "db:backup": "node scripts/db-backup.js",
    "db:backup:list": "node scripts/db-backup.js list",
    "db:restore": "node scripts/db-restore.js",
    "start:prod": "npm run db:setup && npm start"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.14.1",
    "zod": "^3.25.28"
  }
}
