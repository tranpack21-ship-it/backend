# Servidor
NODE_ENV=development
PORT=3000

# Base de datos MySQL (local o Railway)
# Railway: podés referenciar MYSQLHOST, MYSQLPORT, etc. del plugin MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tran_pack
DB_TIMEZONE=-03:00

# SSL MySQL (Railway / hosts remotos)
# En producción con host remoto se activa automáticamente.
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false
# DB_SSL_CA=   # opcional: certificado CA en una línea con \n

# Usuario admin (npm run db:setup — ADMIN_PASSWORD obligatoria)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!

# JWT (obligatorio en producción, mínimo 32 caracteres)
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio_min_32_chars
JWT_EXPIRES_IN=8h

# CORS — URL exacta del frontend (Vercel)
# Múltiples orígenes separados por coma (prod + previews)
CORS_ORIGIN=http://localhost:5173

# Rate limiting (desactivado en development por defecto)
# RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

# Backups MySQL (npm run db:backup)
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_COUNT=50
BACKUP_COMPRESS=true
BACKUP_USE_MYSQLDUMP=true

# Alertas del sistema (horas con caja abierta antes de notificar)
ALERT_CASH_OPEN_HOURS=12
# En Railway con volumen: BACKUP_DIR=/data/backups
